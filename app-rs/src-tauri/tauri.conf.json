{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysKit",
  "mainBinaryName": "SysKit",
  "version": "1.9.4",
  "identifier": "com.syskit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SysKit",
        "width": 980,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "maxWidth": 1280,
        "maxHeight": 860,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
