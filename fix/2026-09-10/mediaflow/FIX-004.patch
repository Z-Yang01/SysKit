---
 backend/app/api/v1/module_ai/rag/chunker.py | 3 ++-
 backend/tests/test_ai_rag_unit.py           | 1 -
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/backend/app/api/v1/module_ai/rag/chunker.py b/backend/app/api/v1/module_ai/rag/chunker.py
index e2f6273..e1533bc 100644
--- a/backend/app/api/v1/module_ai/rag/chunker.py
+++ b/backend/app/api/v1/module_ai/rag/chunker.py
@@ -134,7 +134,8 @@ class TextChunker:
             chunk = text[start:end].strip()
             if chunk:
                 chunks.append(chunk)
-            start = end - self.chunk_overlap
+            # 保证 start 严格前进：分隔符紧邻 start 时 end-overlap 会停滞/倒退，导致死循环与内存爆炸
+            start = max(end - self.chunk_overlap, start + 1)
             if start >= len(text):
                 break
 
diff --git a/backend/tests/test_ai_rag_unit.py b/backend/tests/test_ai_rag_unit.py
index a99e17d..99ca344 100644
--- a/backend/tests/test_ai_rag_unit.py
+++ b/backend/tests/test_ai_rag_unit.py
@@ -73,7 +73,6 @@ def test_chunker_hard_split_keeps_overlap():
 
 
 @pytest.mark.timeout(30)
-@pytest.mark.xfail(strict=False, reason="疑似bug#3: 该测试执行时 python 进程内存膨胀至7.4GB被OOM击杀(疑似chunker死循环), 见PROGRESS.md")
 def test_chunker_paragraph_strategy():
     chunker = TextChunker(chunk_size=100, chunk_overlap=20, strategy="paragraph")
     chunks = chunker.chunk("First paragraph here.\n\nSecond paragraph here.")
