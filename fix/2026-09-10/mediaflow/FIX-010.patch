---
 backend/app/api/v1/module_common/document/api.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/backend/app/api/v1/module_common/document/api.py b/backend/app/api/v1/module_common/document/api.py
index cee9093..a6f5aa4 100644
--- a/backend/app/api/v1/module_common/document/api.py
+++ b/backend/app/api/v1/module_common/document/api.py
@@ -102,7 +102,10 @@ def convert_document(
 
     filename = _safe_filename(file.filename, target)
     media_type = CONTENT_TYPES[target]
-    ascii_name = filename.encode("ascii", "ignore").decode("ascii") or "document" + FILE_EXTENSIONS[target]
+    # 非 ASCII 文件名剔除后 basename 可能为空（如「截图.epub」）→ ASCII 回退名用 document+扩展名
+    _root, _ext = os.path.splitext(filename)
+    ascii_root = _root.encode("ascii", "ignore").decode("ascii")
+    ascii_name = (ascii_root + _ext) if ascii_root else ("document" + FILE_EXTENSIONS[target])
     disposition = f"attachment; filename=\"{ascii_name}\"; filename*=UTF-8''{_quote(filename)}"
 
     return Response(
