diff --git a/backend/tests/test_mediaconv_document.py b/backend/tests/test_mediaconv_document.py
index ab00c53..078cdae 100644
--- a/backend/tests/test_mediaconv_document.py
+++ b/backend/tests/test_mediaconv_document.py
@@ -102,7 +102,7 @@ async def test_pdf_to_markdown(client):
         data={"target_format": "markdown"},
     )
     assert res.status_code == 200
-    assert res.headers["content-type"] == "text/markdown"
+    assert res.headers["content-type"].split(";")[0] == "text/markdown"
     assert 'filename="doc.md"' in res.headers["content-disposition"]
     text = res.content.decode("utf-8")
     assert "# Big Heading" in text
@@ -118,7 +118,7 @@ async def test_epub_to_markdown(client):
         data={"target_format": "markdown"},
     )
     assert res.status_code == 200
-    assert res.headers["content-type"] == "text/markdown"
+    assert res.headers["content-type"].split(";")[0] == "text/markdown"
     assert 'filename="book.md"' in res.headers["content-disposition"]
     text = res.content.decode("utf-8")
     assert "# Chapter 1" in text
