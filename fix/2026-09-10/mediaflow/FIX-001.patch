diff --git a/backend/app/api/v1/module_common/blog/service.py b/backend/app/api/v1/module_common/blog/service.py
index 5346066..90007c6 100644
--- a/backend/app/api/v1/module_common/blog/service.py
+++ b/backend/app/api/v1/module_common/blog/service.py
@@ -278,13 +278,13 @@ class TagService:
     async def suggest(self, q: str, limit: int = 10) -> list[dict]:
         """UGC 自动补全：模糊搜索已有标签。"""
         stmt = (
-            select(Tag.id, Tag.name, Tag.slug, Tag.color)
+            select(Tag.id, Tag.name, Tag.slug, Tag.color, Tag.created_at)
             .where(Tag.name.ilike(f"%{q}%"))
             .order_by(Tag.name)
             .limit(limit)
         )
         result = await self.db.execute(stmt)
-        return [{"id": t[0], "name": t[1], "slug": t[2], "color": t[3]} for t in result.all()]
+        return [{"id": t[0], "name": t[1], "slug": t[2], "color": t[3], "created_at": t[4]} for t in result.all()]
 
     @staticmethod
     def _slugify(name: str) -> str:
@@ -298,11 +298,11 @@ class TagService:
 
     async def get_multi(self) -> list[dict]:
         stmt = select(
-            Tag.id, Tag.name, Tag.slug, Tag.color,
+            Tag.id, Tag.name, Tag.slug, Tag.color, Tag.created_at,
             func.count(article_tags.c.article_id).label("article_count")
         ).outerjoin(article_tags, article_tags.c.tag_id == Tag.id).group_by(Tag.id)
         result = await self.db.execute(stmt)
-        return [{"id": t[0], "name": t[1], "slug": t[2], "color": t[3], "article_count": t[4]} for t in result.all()]
+        return [{"id": t[0], "name": t[1], "slug": t[2], "color": t[3], "created_at": t[4], "article_count": t[5]} for t in result.all()]
 
     async def update(self, tag_id: str, **data) -> Optional[Tag]:
         return await self.crud.update(tag_id, **data)
diff --git a/backend/tests/test_blog_tags.py b/backend/tests/test_blog_tags.py
index 8b00549..c2a1c08 100644
--- a/backend/tests/test_blog_tags.py
+++ b/backend/tests/test_blog_tags.py
@@ -43,10 +43,6 @@ async def test_list_tags_empty_ok(client):
     assert res.json() == []
 
 
-@pytest.mark.xfail(reason=(
-    "疑似 app bug：TagService.get_multi 返回的 dict 不含 created_at，"
-    "而 TagResponse 要求该字段 → 有标签时 GET /tags 500。详见 tests/test_blog_NOTES.md"
-), strict=False)
 async def test_list_tags_with_article_count(client, make_user, db_session):
     from app.api.v1.module_common.blog.service import ArticleService, TagService
 
@@ -102,10 +98,6 @@ async def test_tag_suggest_no_match_ok(client):
     assert res.json() == []
 
 
-@pytest.mark.xfail(reason=(
-    "疑似 app bug：TagService.suggest 返回的 dict 不含 created_at，"
-    "而 TagResponse 要求该字段 → 有匹配时 GET /tags/suggest 500。详见 tests/test_blog_NOTES.md"
-), strict=False)
 async def test_tag_suggest(client, make_user, db_session):
     from app.api.v1.module_common.blog.service import TagService
 
