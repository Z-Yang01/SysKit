---
 backend/tests/test_engage_comment.py | 9 +++++++--
 backend/tests/test_engage_like.py    | 9 +++++++--
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/backend/tests/test_engage_comment.py b/backend/tests/test_engage_comment.py
index 073ebed..f38bf4b 100644
--- a/backend/tests/test_engage_comment.py
+++ b/backend/tests/test_engage_comment.py
@@ -355,7 +355,10 @@ async def test_article_comment_count_updates(client, make_user, db_session):
     await _create(client, commenter, "article", article.id, "nice")
     await _create(client, commenter, "article", article.id, "again")
 
-    row = await db_session.execute(select(Article).where(Article.id == article.id))
+    # 端点经独立 session 已提交；populate_existing 强制覆盖 identity map 中的旧对象
+    row = await db_session.execute(
+        select(Article).where(Article.id == article.id).execution_options(populate_existing=True)
+    )
     assert row.scalar_one().comment_count == 2
 
     # 软删一条 → 计数 -1
@@ -365,5 +368,7 @@ async def test_article_comment_count_updates(client, make_user, db_session):
     target = comments[0]["id"]
     await client.delete(f"{BASE}/{target}", headers=auth_headers(commenter, permissions=DELETE_PERM))
 
-    row = await db_session.execute(select(Article).where(Article.id == article.id))
+    row = await db_session.execute(
+        select(Article).where(Article.id == article.id).execution_options(populate_existing=True)
+    )
     assert row.scalar_one().comment_count == 1
diff --git a/backend/tests/test_engage_like.py b/backend/tests/test_engage_like.py
index 9bace0d..0ba071e 100644
--- a/backend/tests/test_engage_like.py
+++ b/backend/tests/test_engage_like.py
@@ -161,13 +161,18 @@ async def test_like_article_updates_article_like_count(client, make_user, db_ses
     res_on = await _toggle(client, liker, "article", article.id)
     assert res_on.json() == {"liked": True, "like_count": 1}
 
-    row = await db_session.execute(select(Article).where(Article.id == article.id))
+    # 端点经独立 session 已提交；populate_existing 强制覆盖 identity map 中的旧对象
+    row = await db_session.execute(
+        select(Article).where(Article.id == article.id).execution_options(populate_existing=True)
+    )
     assert row.scalar_one().like_count == 1
 
     res_off = await _toggle(client, liker, "article", article.id)
     assert res_off.json() == {"liked": False, "like_count": 0}
 
-    row = await db_session.execute(select(Article).where(Article.id == article.id))
+    row = await db_session.execute(
+        select(Article).where(Article.id == article.id).execution_options(populate_existing=True)
+    )
     assert row.scalar_one().like_count == 0
 
 
